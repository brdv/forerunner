{
    "name": "brdv/forerunner",
    "description": "A Laravel package that provides an elegant, migration-inspired API for defining JSON schemas that ensure your LLM responses are perfectly structured every time.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bram",
            "email": "brdv@pm.me"
        },
        {
            "name": "Blaspsoft",
            "email": "support@blaspsoft.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Blaspsoft\\Forerunner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blaspsoft\\Forerunner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blaspsoft\\Forerunner\\ForerunnerServiceProvider"
            ],
            "aliases": {
                "Schema": "Blaspsoft\\Forerunner\\Facades\\Schema"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
